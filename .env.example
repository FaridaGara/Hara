# Django
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
GOOGLE_OAUTH_CLIENT_IDS=your-google-web-client-id.apps.googleusercontent.com
APPLE_OAUTH_CLIENT_IDS=today.hara.web

# Transactional email / verification codes
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=HARA <no-reply@hara.today>
AUTH_CODE_LIFETIME_SECONDS=600
AUTH_CODE_RESEND_COOLDOWN_SECONDS=60
AUTH_CODE_MAX_ATTEMPTS=5

# PostgreSQL / PostGIS
DB_NAME=hara
DB_USER=hara
DB_PASSWORD=replace-with-a-local-database-password
DB_HOST=localhost
DB_PORT=5432

# Payments — local sandbox example
PAYMENT_PROVIDER=sandbox
PAYMENT_SANDBOX_ENABLED=true
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-local-webhook-secret

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
NEXT_PUBLIC_APPLE_CLIENT_ID=today.hara.web
NEXT_PUBLIC_APPLE_REDIRECT_URI=https://www.hara.today/login
