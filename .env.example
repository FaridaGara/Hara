# Django
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
GOOGLE_OAUTH_CLIENT_IDS=your-google-web-client-id.apps.googleusercontent.com
APPLE_OAUTH_CLIENT_IDS=today.hara.web

# PostgreSQL / PostGIS
DB_NAME=hara
DB_USER=hara
DB_PASSWORD=replace-with-a-local-database-password
DB_HOST=localhost
DB_PORT=5432

# Payments — local sandbox example
PAYMENT_PROVIDER=sandbox
PAYMENT_SANDBOX_ENABLED=true
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-local-webhook-secret

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
NEXT_PUBLIC_APPLE_CLIENT_ID=today.hara.web
NEXT_PUBLIC_APPLE_REDIRECT_URI=https://www.hara.today/login
